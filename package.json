{
  "name": "orchestra",
  "private": true,
  "version": "0.1.0",
  "description": "Agent orchestration framework focused on getting project work done.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hosted-web": "VITE_ORCHESTRA_HOST_MODE=hosted_web tsc --noEmit && vite build",
    "prepare:bundled-pi-runtime": "node ./scripts/prepare-bundled-pi-runtime.mjs",
    "validate:packaged-runtime": "./scripts/run-packaged-runtime-validation.sh",
    "verify:bundled-pi-release": "./scripts/verify-bundled-pi-release.sh release",
    "scan:secrets": "./scripts/run-secret-scan.sh source",
    "scan:history": "./scripts/run-secret-scan.sh history",
    "scan:machine-refs": "node ./scripts/scan-machine-references.mjs --mode source",
    "scan:guardrails": "npm run scan:secrets && npm run scan:history && npm run scan:machine-refs",
    "scan:artifacts": "./scripts/scan-release-artifacts.sh debug",
    "scan:artifacts:release": "./scripts/scan-release-artifacts.sh release",
    "build:adhoc:verified": "npm run scan:guardrails && ORCHESTRA_BUILD_PROFILE=release ORCHESTRA_SANITIZE_BUILD_PATHS=1 ./scripts/build-adhoc.sh && npm run scan:artifacts:release",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui:matrix": "node ./scripts/check-ui-coverage-matrix.mjs",
    "verify": "npm run test:coverage && npm run test:ui:matrix",
    "ci": "npm run verify",
    "test:e2e": "playwright test",
    "test:hosted-web:e2e": "playwright test --config playwright.hosted-web.config.ts",
    "test:web-driver:e2e": "./scripts/run-web-driver-e2e.sh",
    "test:desktop-e2e:host": "./scripts/run-desktop-e2e-suite.sh",
    "test:desktop-e2e": "./scripts/run-desktop-e2e-suite-podman.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-notification": "2.3.3",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.60.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
